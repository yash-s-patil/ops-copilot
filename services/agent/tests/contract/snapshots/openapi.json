    "/api/tickets/{ticket_id}/resolve": {
      "post": {
        "description": "Behind the Confirm resolve button, and nowhere else.\n\nThe same three steps as any change: the request is recorded, the person who clicked\napproves it, and it is carried out with that approval. The audit log shows all three.\nThe page sends one `Idempotency-Key` for one click and repeats it if it must ask\nagain, so a repeat goes on from where the first attempt stopped and asks for nothing new.",
        "operationId": "resolve_api_tickets__ticket_id__resolve_post",
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "title": "Ticket Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{8,56}$",
